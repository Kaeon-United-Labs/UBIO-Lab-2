# ════════════════════════════════════════════════════════════════════
# The two switches that determine everything else.
# ════════════════════════════════════════════════════════════════════

# bitcoin | stripe | paypal  (stripe and paypal both mean USD)
PAYMENT_RAIL=bitcoin

# single | federated
#   single     one institution, one install — behaves exactly like Stage/UBIO
#              when PAYMENT_RAIL=bitcoin.
#   federated  anyone can create a group and run their own program on this
#              one deployment — behaves exactly like Lab/2 when
#              PAYMENT_RAIL=stripe.
PLATFORM_MODE=single

# ---- Server ----
PORT=3000
# Base URL this server is reachable at — used to build onboarding/redirect
# links (Stripe Connect, PayPal checkout). Defaults to http://localhost:$PORT.
# PUBLIC_URL=https://ubi.example.org

# ---- Database ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ubio

# ---- Auth ----
# Signs federated-mode admin tokens and every recipient ("logged-in user")
# login token, in both modes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Cadence ----
# usd rails: how often the payout monitor tick runs.
PAYOUT_INTERVAL_MS=60000
# bitcoin rail: how often the whole pool is distributed. Default: 7 days.
DISTRIBUTION_INTERVAL_MS=604800000
# bitcoin rail: how often the scheduler checks the clock. Default: 60s.
SCHEDULER_TICK_MS=60000

# ════════════════════════════════════════════════════════════════════
# PLATFORM_MODE=single only
# ════════════════════════════════════════════════════════════════════

# Admin panel password; also accepted as the API bearer token, per spec.
ADMIN_PASSWORD=
# Optional: a random secret for signing the admin session cookie (defaults
# to ADMIN_PASSWORD).
# SESSION_SECRET=
# Displayed on the public page.
INSTITUTION_NAME=Example Mutual Aid
# usd rails only, single mode only: payout unit = $1.00 * ROUND_THRESHOLD.
# ROUND_THRESHOLD=1

# ════════════════════════════════════════════════════════════════════
# PAYMENT_RAIL=bitcoin
# ════════════════════════════════════════════════════════════════════

# "testnet" (default, safe) or "mainnet" (real funds).
BTC_NETWORK=testnet
# Required ONLY when BTC_NETWORK=mainnet — an explicit acknowledgement that
# wallet private keys live in plaintext (env in single mode, the database in
# federated mode) next to a public web surface.
# I_UNDERSTAND_MAINNET_RISK=yes
# Esplora-compatible REST API. Defaults to Blockstream for the chosen network.
# ESPLORA_BASE_URL=https://blockstream.info/testnet/api

# single mode only — the one institution's wallet. (Federated mode instead
# mints a fresh wallet per group automatically at group-creation time.)
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# ════════════════════════════════════════════════════════════════════
# PAYMENT_RAIL=stripe
# ════════════════════════════════════════════════════════════════════

# With STRIPE_MOCK=true (default), no Stripe account is needed: donations
# confirm immediately, Connect accounts/onboarding links are faked, and
# transfers log to the console instead of moving money.
STRIPE_MOCK=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ════════════════════════════════════════════════════════════════════
# PAYMENT_RAIL=paypal
# ════════════════════════════════════════════════════════════════════

# With PAYPAL_MOCK=true (default), no PayPal app is needed: donations
# confirm immediately and payouts log to the console instead of moving money.
PAYPAL_MOCK=true
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # or https://api-m.paypal.com live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
